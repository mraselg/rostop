<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ==========================================================================
# Performance: Gzip compression (top-load)
# ==========================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# ==========================================================================
# Performance: Browser caching (long-lived immutable fingerprints for media)
# ==========================================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Vector & modern raster assets (brands/banners) — fingerprinted names
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp  "access plus 1 year"
    ExpiresByType font/woff2   "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Legacy raster media
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"

    # CSS/JS bundles (versioned via ?v= query)
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresDefault "access plus 2 days"
</IfModule>

<IfModule mod_headers.c>
    # Immutable for fingerprinted vector/modern assets
    <FilesMatch "\.(svg|webp|woff2|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Monthly cache for versioned bundles
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Dynamic HTML: always revalidate
    <FilesMatch "\.php$">
        Header set Cache-Control "private, no-cache, must-revalidate"
    </FilesMatch>

    # Security headers (harmless, SEO/bot trust friendly)
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
